# Ponder GraphQL indexer. Defaults to http://localhost:42069/graphql, which
# silently degrades every indexer-backed page if it is wrong in production.
PONDER_URL=http://localhost:42069/graphql

# Arbitrum Sepolia RPC. Optional, but the public fallback rate-limits the
# historical getLogs scans that back the TVS figures — set a dedicated
# provider for any real deployment.
ARB_SEPOLIA_RPC_URL=

# Ethereum Sepolia RPC. Same reasoning.
ETH_SEPOLIA_RPC_URL=
